# SmartDoc Enterprise - PostgreSQL Configuration
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=smartdoc

PORT=3001

# Default Super Admin Account (Created automatically on startup if not present in DB)
SUPER_ADMIN_NAME=Super Administrator
SUPER_ADMIN_EMAIL=admin@smartdoc.com
SUPER_ADMIN_PASSWORD=admin123
